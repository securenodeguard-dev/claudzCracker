# This root file documents ALL environment variables used across the monorepo.
# Each app also has its own .env.example (backend/.env.example) — copy that one
# into backend/.env, consumer-portal/.env, admin-portal/.env respectively.
# NEVER commit real .env files.

# ---------- Backend (backend/.env) ----------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

MONGODB_URI=mongodb://localhost:27017/cracker_shop

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=15m

CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

CORS_ORIGINS=http://localhost:4200,http://localhost:4300

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=20

# Used only by scripts/seed-admin.ts — never commit real values
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_locally_only

# ---------- Consumer Portal (consumer-portal/src/environments) ----------
# Angular env files are NOT read from process env at runtime (Angular builds
# are static). Edit consumer-portal/src/environments/environment.ts and
# environment.prod.ts directly with the public API base URL. No secrets ever
# go into Angular code.
CONSUMER_API_BASE_URL=http://localhost:3000/api/v1

# ---------- Admin Portal (admin-portal/src/environments) ----------
ADMIN_API_BASE_URL=http://localhost:3000/api/v1
